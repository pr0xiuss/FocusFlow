{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Django (backend_new)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend_new/focusflow/manage.py",
      "args": [
        "runserver",
